# Copy this file to `.env.local` only if Clerk has not already written one.
# `npx clerk@latest init` creates development keys automatically.
# Full walkthrough: docs/AUTH.md

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Local Postgres (docker compose). Start with: docker compose up -d
DATABASE_URL="postgresql://truefit:truefit@localhost:5435/truefit?schema=public"

# Optional: Clerk Dashboard → Webhooks → Signing Secret
# Needed only for /api/webhooks/clerk (user/session sync from Clerk events).
CLERK_WEBHOOK_SIGNING_SECRET=

# Needed for /api/documents to extract structured profile data (titles,
# skills, experience) from uploaded CVs via the OpenAI API.
OPENAI_API_KEY=

# Optional: overrides the OpenAI model used for CV/job parsing and CV
# tailoring generation (defaults to gpt-4o-mini if unset). Set this to
# switch models or compare output quality/cost across models.
OPENAI_MODEL=
