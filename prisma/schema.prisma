generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  clerkUserId String      @unique
  email       String?
  name        String?
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sessions    Session[]
  cvs         Cv[]
  jobPosts    JobPost[]
  tailorings  Tailoring[]
}

model Session {
  id             String    @id @default(cuid())
  clerkSessionId String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String    @default("active")
  expiresAt      DateTime?
  lastActiveAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Cv {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName       String
  fileType       String
  fileSize       Int
  fileHash       String
  extractedText  String   @db.Text
  parsedHeadline String?
  parsedLocation String?
  parsedYears    Int?
  parsedSkills   Json?
  parsedRoles    Json?
  createdAt      DateTime @default(now())

  @@unique([userId, fileHash])
  @@map("cvs")
}

model JobPost {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceUrl          String
  urlHash            String
  rawText            String     @db.Text
  parsedTitle        String?
  parsedCompany      String?
  parsedLocation     String?
  parsedDescription  String?    @db.Text
  parsedRequirements Json?
  createdAt          DateTime   @default(now())
  tailoring          Tailoring?

  @@unique([userId, urlHash])
  @@map("job_posts")
}

model Tailoring {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostId              String   @unique
  jobPost                JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  model                  String
  tailoredCv             Json
  coverLetter            String   @db.Text
  whatChanged            Json
  preTailoringMatchScore Int      @default(0)
  preTailoringBreakdown  Json?
  atsScore               Int
  atsScoreBreakdown      Json?
  keywordsCovered        Json
  unmetRequirement       String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@map("tailorings")
}
